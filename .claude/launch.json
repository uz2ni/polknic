{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5173", "--bind", "127.0.0.1"],
      "port": 5173
    },
    {
      "name": "lan",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5174", "--bind", "0.0.0.0"],
      "port": 5174
    },
    {
      "name": "server",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd server && PATH=$HOME/.nvm/versions/node/v24.21.0/bin:$PATH npx wrangler dev --port 8787 --ip 0.0.0.0"],
      "port": 8787
    },
    {
      "name": "server-test",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd server && PATH=$HOME/.nvm/versions/node/v24.21.0/bin:$PATH npx wrangler dev --port 8790 --var ROOM_CAP:3"],
      "port": 8790
    }
  ]
}
